{
  "name": "whichai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "goals:report": "vitest run src/lib/plan/goal-corpus.test.ts",
    "data:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data-report.ts",
    "data:version": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalogue-version.ts",
    "links:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-links.ts",
    "news:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-news.ts",
    "discover": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/discover.ts",
    "discover:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/discover.ts --dry-run",
    "discover:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/discover-import.ts"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "fast-xml-parser": "^5.12.0",
    "jose": "^6.2.16",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
