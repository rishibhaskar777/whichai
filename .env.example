# Copy to .env.local and fill in values. Never commit .env.local.
# Names only. No real values in this file.

# Public site URL, used for metadata and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign-in is optional. Leave these empty and the Sign in popup says it is not configured.
# Secret for the session cookie, at least 32 random bytes (see docs/AUTH-SETUP.md)
AUTH_SECRET=
# Google OAuth client ID
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app client ID
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret
GITHUB_CLIENT_SECRET=
